{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luhabit",
  "account_id": "2a64370793cc62f011e8478b50abd5ac",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_URL": "https://luhabit.luhabit.workers.dev",
    "OWNER_EMAIL": "luciano.kontakt@gmail.com",
    // Die Client-ID ist öffentlich — sie steht beim Login in der Adresszeile.
    // Nur das Client-Secret gehört in die Secret-Verwaltung.
    "GOOGLE_CLIENT_ID": "919163979741-bfr5ppe4ido3023gnh7caodskt88b0fh.apps.googleusercontent.com"
  },
  "observability": {
    "enabled": true
  }
}
